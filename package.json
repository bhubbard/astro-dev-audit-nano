{
  "name": "astro-dev-audit-nano",
  "version": "1.0.0",
  "description": "Astro Dev Toolbar integration for real-time WCAG a11y & SEO audits powered by Chrome Built-in AI (Gemini Nano)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/app.ts --outdir ./dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "dev-toolbar",
    "accessibility",
    "a11y",
    "wcag",
    "seo",
    "chrome-ai",
    "gemini-nano",
    "window.ai"
  ],
  "author": "bhubbard",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
